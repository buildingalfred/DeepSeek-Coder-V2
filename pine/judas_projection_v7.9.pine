// © swing-sweep projection — v7.9  (clicked signal candle · 0.618 confirmation · 15m trigger → 1m entry · re-measure after a stop · alarm switch)
//@version=6
indicator("Judas Projection", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// WHAT THIS DOES
//
//   You write ONE projection — a high and a low. The grid is tiled from it,
//   both ways, and those bands are the ONLY levels that exist.
//
//   The signal: a swing high is taken by a newer swing high (or a low by a
//   newer low) and both of them sit inside one of your bands.
//
//   Write nothing and the script draws nothing and signals nothing.
//
// ─── WHAT v7.5 ADDS: THE 1m SETUP ────────────────────────────────────────────
// Run on the 1-minute chart.
//   1. TRIGGER  price trades past a 15m swing that sits inside a band
//               (bearish: above a 15m swing high).
//   2. MEASURE  fib 0 = the extreme since the trigger, fib 1 = the last 1m
//               swing low that took another swing low before it. A new high
//               moves 0 and re-picks 1.
//   3. ARM      a 1m candle closes past 0.618 (bearish: below). Fib locks.
//   4. ENTER    limit at 0.618.
//   5. STOP     (0.618 − 0.382 range) × 2 beyond entry. TARGET 5R.
//
// ─── v7.9: THE ALARM SWITCH ──────────────────────────────────────────────────
//   🔔 at the top of the settings turns the setup alarms on. It fires when a
//   setup APPEARS (a 15m swing inside a band is taken) and again when it is
//   ARMED (with limit, stop and target). To receive them, create ONE alert:
//   Condition "Judas Projection" → "Any alert() function call".
//   TradingView alerts keep the settings they were created with — after you
//   move the signal candle or change any setting, delete and re-create it.
// ══════════════════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════════════════
// ─── INPUTS ───────────────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════════════
gAlarm  = "═══ 🔔 Alarm ═══"
alarmOn = input.bool(true, "🔔 Set alarm when setup appears", group=gAlarm, tooltip="ON: the script sends an alarm when a setup appears (a trigger-timeframe swing inside a band is taken) and when it is armed (limit, stop and target in the message).\n\nTo receive it: Alert (clock icon) → Condition: Judas Projection → Any alert() function call → Create.\n\nIMPORTANT: an alert keeps the settings it was created with. Every time you move the signal candle or change a setting, delete the old alert and create it again.")

gMode = "═══ Mode ═══"
trackOn = input.bool(true, "Live Tracking", group=gMode, tooltip="OFF: no levels are built and nothing can signal. The chart is bare.")

gProj = "═══ The Projection ═══"
projUnits = input.int(4, "Tile This Many Units Each Way", minval=1, maxval=10, group=gProj, tooltip="How far the grid repeats above and below the range you wrote. Every unit contributes one band, and every band can signal.")
projDepth = input.int(0, "Subdivide This Deep", minval=0, maxval=4, group=gProj, tooltip="0 = the projection bands only. 1 adds the 0.382/0.5/0.618 of each GAP between bands, which is exactly the event horizon (±0.0902 R). 2 subdivides again.")
projIn    = input.bool(true, "Include The Band Inside The Written Range", group=gProj, tooltip="The band between the high and the low you typed. OFF and only the projections outside the range can signal.")

projSrc   = input.string("Signal candle (click it)", "Projection From", options=["Signal candle (click it)", "Typed High / Low"], group=gProj, tooltip="Signal candle: click the candle your 15m Engine marked. The script takes its high (or low) as 1, and the last swing low that took out another swing low before it (or the last high that took a high) as 0. Typed: the High / Low you write below.")
sigT      = input.time(timestamp("2026-10-06T10:30:00-04:00"), "Signal Candle", confirm=true, group=gProj, tooltip="Click anywhere inside the signal candle. On the 1-minute chart any minute of that 15m candle will do. Drag the marker to move it to the next signal.")
sigSide2  = input.string("At a high (short projection)", "Signal Is", options=["At a high (short projection)", "At a low (long projection)"], group=gProj)
ancMinT   = input.int(1, "Anchor Take Must Clear By (ticks)", minval=0, maxval=500, group=gProj, tooltip="How far below the earlier swing low a swing low must go to count as having taken it — on the Trigger Timeframe's swings. 1 = any lower low.")
autoMode  = projSrc == "Signal candle (click it)"
confOn    = input.bool(true, "Wait For A Close Past The Projection's 0.618", group=gProj, tooltip="Confirmation. No setup in the projection's direction can start until a candle closes past this level of the projection leg (bullish: ABOVE it, measured up from the signal low; bearish: BELOW it, measured down from the signal high). Only swings taken AFTER that close count. The other direction is not affected.")
confFib   = input.float(0.618, "Confirmation Level", minval=0.0, maxval=1.0, step=0.001, group=gProj)
confTF    = input.string("Trigger timeframe close", "Confirm On", options=["Trigger timeframe close", "Chart (1m) close"], group=gProj, tooltip="Trigger timeframe close: a closed 15m candle must be past the level, as in your 15m picture. Chart close: the first 1m close past it is enough — earlier, but noisier.")

pOn   = input.bool(false, "On", inline="p1", group=gProj)
pHi   = input.float(0.0, "High", inline="p1", group=gProj)
pLo   = input.float(0.0, "Low", inline="p1", group=gProj)
pCol  = input.color(color.new(#9c27b0, 0), "", inline="p1", group=gProj)
pEH   = input.bool(false, "Show EH", inline="p1", group=gProj, tooltip="Draw AND arm the event horizons: the belly of the gap between adjacent bands, i.e. each whole level ±0.0902 R. A take landing inside one marks like any other level.")
pEHC  = input.color(color.new(#ffd600, 0), "", inline="p1", group=gProj)
pDir  = input.string("Short (0 at the low)", "", options=["Short (0 at the low)","Long (0 at the high)"], inline="p1d", group=gProj)
pFill = input.color(color.new(#00c853, 0), "Fill", inline="p1d", group=gProj)

gSig = "═══ The Signal ═══"
sigSide  = input.string("Bearish — a high takes a high", "Look For", options=["Bearish — a high takes a high","Bullish — a low takes a low","Both"], group=gSig, tooltip="The taking swing is the signal. Bearish: a swing high runs past an earlier swing high while inside one of your bands. Bullish is the mirror.")
sigKinds = input.string("Projection bands", "Only Inside", options=["Projection bands","Both","Event horizons"], group=gSig, tooltip="Which kind of level the take has to land in. Show EH widens Projection bands to admit horizons as well. Set Event horizons to see ONLY the horizons.")
ehArm    = input.bool(true, "Show EH Also Arms It", group=gSig, tooltip="ON: a ticked Show EH box both draws the horizon and lets a take mark inside it, whatever Only Inside says. OFF: Show EH is drawing only.")
grabBy   = input.string("Either — wick or body inside", "Measure The Take By", options=["Wick (the extreme)","Body (a wick may poke through)","Either — wick or body inside"], group=gSig, tooltip="Wick: the swing extreme itself must be inside the level — rejects a sweep. Body: the bar's body extreme must be inside. Either: accepts whichever is inside, which admits both the clean take and the sweep.")
bothIn   = input.bool(true, "Both Swings Must Be Inside The Level", group=gSig, tooltip="The high that gets taken AND the high that takes it both have to sit in the SAME band.")
sweepOut = input.int(28, "Wick May Sweep Past The Level By (ticks)", minval=0, maxval=2000, group=gSig, tooltip="Only applies when a take is accepted on its BODY while the wick sits outside the level. How far past the edge the wick may run and still count. 28t is 7.00 points on a 0.25 tick.")
hitTol   = input.int(4, "Counts As Inside Within (ticks)", minval=0, maxval=200, group=gSig, tooltip="Slack on the band's edges. 0 means strictly between lo and hi.")
sigTag   = input.string("JUDAS", "Mark Text", group=gSig)
sigColUp = input.color(color.new(#00c853, 0), "Bullish", inline="sgc", group=gSig)
sigColDn = input.color(color.new(#ff3b30, 0), "Bearish", inline="sgc", group=gSig)
sigSize  = input.string(size.small, "Mark Size", options=[size.tiny, size.small, size.normal, size.large], group=gSig)
sigKeep  = input.int(40, "Keep This Many Marks", minval=1, maxval=400, group=gSig, tooltip="Oldest are dropped first.")
sigShowBox = input.bool(false, "Draw The Level Each Mark Fired In", group=gSig)
sigBoxCol  = input.color(color.new(#2962ff, 70), "Fired-In Level", group=gSig)
sigBoxPad  = input.int(8, "Draw It This Many Bars Each Side", minval=1, maxval=200, group=gSig)
showMiss = input.bool(false, "Mark Takes That Did Not Qualify", group=gSig, tooltip="A grey x wherever a swing took liquidity but no band accepted it. Hover it for the reason.")
alertOn  = input.bool(true, "Fire An Alert With The Reason", group=gSig, tooltip="Set the TradingView alert to Any alert() function call.")

gSet = "═══ The 1m Setup ═══"
setOn    = input.bool(true, "Run The Setup", group=gSet, tooltip="Put the script on the 1-minute chart. The trigger swings come from the timeframe below; everything else is measured on the chart's own bars.")
setTF    = input.timeframe("15", "Trigger Timeframe", group=gSet, tooltip="The setup starts the moment price trades past a swing of THIS timeframe that sits inside one of your bands. Its swings use the Swing Definition from the Swings group and only closed bars, so they never repaint.")
entFib   = input.float(0.618, "Enter At", minval=0.0, maxval=1.0, step=0.001, group=gSet, tooltip="A 1m close past this level arms the setup; a limit order sits here.")
rngFib   = input.float(0.382, "Stop Range From", minval=0.0, maxval=1.0, step=0.001, group=gSet, tooltip="Stop distance = (Enter At level − this level) × the multiplier below, both rounded to the tick.")
slMult   = input.float(2.0, "Stop = Range ×", minval=0.1, step=0.1, group=gSet)
rrTP     = input.float(5.0, "Target (R)", minval=0.1, step=0.5, group=gSet)
setKeep  = input.int(20, "Keep This Many Setups Drawn", minval=1, maxval=60, group=gSet)
setFibCol = input.color(color.new(#f23645, 0), "Fib", inline="stc", group=gSet)
setRiskCol = input.color(color.new(#f23645, 0), "Risk", inline="stc", group=gSet)
setRewCol  = input.color(color.new(#089981, 0), "Reward", inline="stc", group=gSet)
setAlertMode = input.string("Setup armed only", "Setup Alerts", options=["Setup armed only", "Armed, fill and exit", "Off"], group=gSet, tooltip="Setup armed only: one alert when a 1m candle CLOSES past the entry level (0.618), carrying the limit, stop and target, so you have time to place the order. It also tells you to pull the limit if Blocked Hours cancel an armed setup. Armed, fill and exit: also when the limit fills and when the trade hits its stop or target. All of these only fire while 🔔 at the top is on.")
alArm  = alarmOn and setAlertMode != "Off"
alFull = alarmOn and setAlertMode == "Armed, fill and exit"

ancSw     = input.string("3", "1m Anchor Swings", options=["3","5"], group=gSet, tooltip="Which 1m swings can be the fib's 1. 3 = top/bottom its neighbours. 5 = must top/bottom two bars each side — fewer, clearer swings. Separate from the Swings group, which drives the JUDAS marks.")
ancClr1   = input.int(2, "1m Anchor Take Must Clear By (ticks)", minval=0, maxval=2000, group=gSet, tooltip="The 1 is the last 1m swing that took out the swing before it by at least this much. Raise it and small chop takes stop counting.")
ancMinFib = input.float(0.0, "Smallest Fib Allowed (points)", minval=0.0, step=0.5, group=gSet, tooltip="0 = off. An anchor closer to 0 than this is skipped and the search goes further back to an older take — this is what stops a fib being built on a tiny chop swing right next to the sweep. A starting point: gold 8, NQ 20.")
maxTries  = input.int(3, "Attempts Per Take", minval=1, maxval=10, group=gSet, tooltip="When a trade is stopped by price running on to a new extreme, the setup does not end: it goes back to measuring with 0 on the new extreme and can arm again — on the same 15m take — up to this many trades. 1 = the old behaviour, one trade per take.")

gBlk = "═══ Blocked Hours ═══"
blkOn     = input.bool(false, "Block New Setups", group=gBlk, tooltip="No setup can START inside this window. A trade already filled is always left to run to its stop or target.")
blkSess   = input.session("1500-0000", "Between", group=gBlk, tooltip="Start–end in the time zone below. A window may run past midnight, e.g. 2200-0300. 0000 as the end means midnight.")
blkTZ     = input.string("America/New_York", "Time Zone", group=gBlk, tooltip="The clock the window is read in, as an IANA name: America/New_York, Europe/Stockholm, Europe/London, UTC… Your chart's own time zone setting does not change it.")
blkCancel = input.bool(true, "Also Cancel Setups Not Yet Filled", group=gBlk, tooltip="ON: a setup still measuring or armed when the window opens is dropped, and an armed one fires a cancel alert so you can pull the limit. OFF: it carries on and may still fill inside the window.")
blkShade  = input.bool(true, "Shade The Blocked Hours", group=gBlk)
blkCol    = input.color(color.new(color.gray, 90), "", group=gBlk)

gHTF = "═══ Other Timeframes ═══"
htfOn      = input.bool(false, "Look For Takes On Other Timeframes", group=gHTF, tooltip="Your levels are absolute prices, so the same band exists on every timeframe. This runs the swing-and-take test on other timeframes against those same bands.")
htfChart   = input.bool(true, "Chart Timeframe", group=gHTF, tooltip="The ordinary signal, on the bars you are looking at.")
h60On = input.bool(false, "1h",  inline="htf", group=gHTF)
h30On = input.bool(false, "30m", inline="htf", group=gHTF)
h15On = input.bool(false, "15m", inline="htf", group=gHTF)
h03On = input.bool(false, "3m",  inline="htf", group=gHTF)
htfMode    = input.string("3", "Swing Definition There", options=["3","5"], group=gHTF)
htfMinTake = input.int(20, "Must Clear It By At Least, There (ticks)", minval=0, maxval=2000, group=gHTF)
htfMinAge  = input.int(1, "The Taken Swing Must Be At Least (bars) Old", minval=0, maxval=500, group=gHTF, tooltip="Counted in bars of THAT timeframe, not yours.")
htfConfirm = input.bool(true, "Only Confirmed Bars", group=gHTF, tooltip="ON: never repaints, costs one bar of that timeframe. OFF is faster and repaints.")
htfNotes   = input.bool(true, "Other Timeframes Are Notes Only", group=gHTF, tooltip="ON: they mark the chart but do not fire alerts.")
htfSize    = input.string(size.tiny, "Note Size", options=[size.tiny, size.small, size.normal, size.large], group=gHTF)
htfCol     = input.color(color.new(#455a64, 0), "Note Colour", group=gHTF)

gSw = "═══ Swings ═══"
swMode     = input.string("3", "Swing Definition", options=["3","5"], group=gSw, tooltip="3 = a bar that tops its immediate neighbours, confirmed one bar late. 5 = it must top the two bars each side.")
showSwings = input.bool(true, "Mark Swing Points", group=gSw)
swLookback = input.int(400, "Keep This Many Bars Of Swings", minval=20, maxval=2000, group=gSw)
swHiCol    = input.color(color.new(#ff3b30, 0), "High", inline="swc", group=gSw)
swLoCol    = input.color(color.new(#00c853, 0), "Low",  inline="swc", group=gSw)
sweepRef   = input.string("The most recent swing", "Must Take", options=["The most recent swing","The furthest of the last N"], group=gSw)
sweepDepth = input.int(1, "N", minval=1, maxval=20, group=gSw, tooltip="Only used by The furthest of the last N.")
minTakeT   = input.int(2, "Must Clear It By At Least (ticks)", minval=0, maxval=1000, group=gSw)
minTakeAge = input.int(1, "The Taken Swing Must Be At Least (bars) Old", minval=0, maxval=500, group=gSw)

gMem = "═══ The Level Register ═══"
mergeTol = input.int(6, "Merge Levels Within (ticks)", minval=0, maxval=200, group=gMem, tooltip="Only matters when subdividing: two levels of the same kind this close become one.")
maxZones = input.int(300, "Hold This Many Levels", minval=10, maxval=500, group=gMem)

gFib = "═══ Drawing ═══"
drawOn     = input.bool(true, "Draw The Projection", group=gFib, tooltip="OFF: the bands and horizons are still built and still signal.")
projStyle  = input.string("Band fill + lines", "Draw Each Level As", options=["Lines","Level boxes","Band fill + lines","Band fill only"], group=gFib)
projThick  = input.int(2, "Level Box Thickness (ticks)", minval=1, maxval=200, group=gFib)
projColMode = input.string("One colour per grid", "Colour", options=["One colour per grid","One colour per ratio"], group=gFib)
colW       = input.color(color.new(#ff9800, 0), "0 / 1", inline="mc", group=gFib)
colA       = input.color(color.new(#9c27b0, 0), "0.382", inline="mc", group=gFib)
colB       = input.color(color.new(#000000, 0), "0.5", inline="mc", group=gFib)
colC       = input.color(color.new(#7e57c2, 0), "0.618", inline="mc", group=gFib)
fillAll    = input.bool(false, "Fill Every Gap Between Levels", group=gFib)
bandCol    = input.color(color.new(#00c853, 0), "Band Fill (0.382→0.618)", inline="mb", group=gFib)
bandOp     = input.int(88, "Transparency", minval=0, maxval=100, inline="mb", group=gFib)
fill1      = input.color(color.new(#26a69a, 0), "0→.382", inline="mf", group=gFib)
fill2      = input.color(color.new(#00c853, 0), ".382→.5", inline="mf", group=gFib)
fill3      = input.color(color.new(#66bb6a, 0), ".5→.618", inline="mf", group=gFib)
fill4      = input.color(color.new(#26a69a, 0), ".618→1", inline="mf", group=gFib)
boxOp      = input.int(35, "Level Box Transparency", minval=0, maxval=100, group=gFib)
ehOp       = input.int(65, "Event Horizon Transparency", minval=0, maxval=100, group=gFib)
projExtend = input.string("Both ways", "Extend", options=["Both ways","Right only","Left only","Neither"], group=gFib)
projBack   = input.int(300, "Start This Many Bars Back", minval=0, maxval=5000, group=gFib)
projLbl    = input.bool(true, "Label Levels", group=gFib)
fibExtend  = input.int(20, "Extend Right (bars)", minval=0, maxval=400, group=gFib)
fibLblSize = input.string(size.tiny, "Level Label Size", options=[size.tiny, size.small, size.normal, size.large], group=gFib)
fibA       = input.float(0.382, "A", minval=0.0, maxval=1.0, step=0.001, inline="fr", group=gFib)
fibB       = input.float(0.5,   "B", minval=0.0, maxval=1.0, step=0.001, inline="fr", group=gFib)
fibC       = input.float(0.618, "C", minval=0.0, maxval=1.0, step=0.001, inline="fr", group=gFib)

gTbl = "═══ State Table ═══"
showTable = input.bool(true, "Show State Table", group=gTbl)
tblRows   = input.int(0, "List This Many Levels", minval=0, maxval=20, group=gTbl, tooltip="Nearest to price first.")
tblPos    = input.string("Top Right", "Position", options=["Top Left","Top Right","Bottom Left","Bottom Right","Middle Right"], group=gTbl)

f_pos(string p) =>
    switch p
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Left"  => position.bottom_left
        "Bottom Right" => position.bottom_right
        "Middle Right" => position.middle_right
        => position.top_right

sigBear = sigSide != "Bullish — a low takes a low"
sigBull = sigSide != "Bearish — a high takes a high"
float minTakePx = minTakeT * syminfo.mintick
float tolPx     = mergeTol * syminfo.mintick
float hitPx     = hitTol   * syminfo.mintick
float sweepPx   = sweepOut * syminfo.mintick

bool ehAny  = (autoMode or pOn) and pEH
bool ehLive = ehArm and ehAny

// ══════════════════════════════════════════════════════════════════════════════
// ─── TYPE ─────────────────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════════════
type Zone
    float lo     = na
    float hi     = na
    float px     = na
    int   kind   = 0        // 0 projection band · 1 event horizon · 2+ deeper
    float u      = na
    float ext    = -1.0
    float orig   = na
    float R      = na
    int   weight = 1
    int   hits   = 0
    int   sigs   = 0

// ══════════════════════════════════════════════════════════════════════════════
// ─── SWING DETECTION ──────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════════════
isRegular(string mode, int n) =>
    mode == "Buy"  ? high[n - 1] < high[n] and high[n + 1] < high[n] :
     mode == "Sell" ? low[n - 1]  > low[n]  and low[n + 1]  > low[n]  : false

isBW(string mode, int n) =>
    mode == "Buy"  ? high[n - 2] < high[n] and high[n - 1] < high[n] and high[n + 1] < high[n] and high[n + 2] < high[n] :
     mode == "Sell" ? low[n - 2]  > low[n]  and low[n - 1]  > low[n]  and low[n + 1]  > low[n]  and low[n + 2]  > low[n]  : false

off       = swMode == "3" ? 1 : 2
isSwingHi = swMode == "3" ? isRegular("Buy", 1)  : isBW("Buy", 2)
isSwingLo = swMode == "3" ? isRegular("Sell", 1) : isBW("Sell", 2)

plotshape(showSwings and isSwingHi, title="Swing High", style=shape.triangledown, location=location.abovebar, color=swHiCol, offset=-off, size=size.tiny)
plotshape(showSwings and isSwingLo, title="Swing Low",  style=shape.triangleup,   location=location.belowbar, color=swLoCol, offset=-off, size=size.tiny)

var float[] hiPx = array.new_float(), var int[] hiBar = array.new_int()
var float[] loPx = array.new_float(), var int[] loBar = array.new_int()

float swHiPxN = na, int swHiBarN = na, float swHiTookN = na
float swLoPxN = na, int swLoBarN = na, float swLoTookN = na
int   swHiTimeN = na, float swHiBodyN = na
int   swLoTimeN = na, float swLoBodyN = na
float nearPx = na, float nearRef = na, int nearAge = na, bool nearBear = false

if isSwingHi
    float p = high[off]
    bool  t = false
    float tk = na
    int   n = array.size(hiPx)
    if n > 0
        float ref = na
        int   refB = na
        if sweepRef == "The most recent swing"
            ref  := array.get(hiPx, n - 1)
            refB := array.get(hiBar, n - 1)
        else
            for j = 1 to math.min(sweepDepth, n)
                float q = array.get(hiPx, n - j)
                if na(ref) or q > ref
                    ref  := q
                    refB := array.get(hiBar, n - j)
        if not na(ref) and p - ref >= minTakePx and (bar_index - off) - refB >= minTakeAge
            t  := true
            tk := ref
        else if not na(ref) and p > ref
            nearPx := p, nearRef := ref, nearAge := (bar_index - off) - refB, nearBear := true
    array.push(hiPx, p), array.push(hiBar, bar_index - off)
    if t
        swHiPxN := p, swHiBarN := bar_index - off, swHiTookN := tk
        swHiTimeN := time[off], swHiBodyN := math.max(open[off], close[off])

if isSwingLo
    float p = low[off]
    bool  t = false
    float tk = na
    int   n = array.size(loPx)
    if n > 0
        float ref = na
        int   refB = na
        if sweepRef == "The most recent swing"
            ref  := array.get(loPx, n - 1)
            refB := array.get(loBar, n - 1)
        else
            for j = 1 to math.min(sweepDepth, n)
                float q = array.get(loPx, n - j)
                if na(ref) or q < ref
                    ref  := q
                    refB := array.get(loBar, n - j)
        if not na(ref) and ref - p >= minTakePx and (bar_index - off) - refB >= minTakeAge
            t  := true
            tk := ref
        else if not na(ref) and p < ref
            nearPx := p, nearRef := ref, nearAge := (bar_index - off) - refB, nearBear := false
    array.push(loPx, p), array.push(loBar, bar_index - off)
    if t
        swLoPxN := p, swLoBarN := bar_index - off, swLoTookN := tk
        swLoTimeN := time[off], swLoBodyN := math.min(open[off], close[off])

while array.size(hiBar) > 0 and bar_index - array.get(hiBar, 0) > swLookback
    array.shift(hiBar), array.shift(hiPx)
while array.size(loBar) > 0 and bar_index - array.get(loBar, 0) > swLookback
    array.shift(loBar), array.shift(loPx)

// ══════════════════════════════════════════════════════════════════════════════
// ─── REGISTERS ────────────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════════════
var Zone[]  zones = array.new<Zone>()
var label[] SIG   = array.new_label()
var box[]   SIGB  = array.new_box()

var string[] sigBox  = array.new_string(1, "")
var string[] missBox = array.new_string(1, "")
var string[] nearBox = array.new_string(1, "")
var int[]    cntBox  = array.new_int(1, 0)

if not na(nearPx)
    int clr = math.round(math.abs(nearPx - nearRef) / syminfo.mintick)
    string s1 = clr < minTakeT ? "cleared it by only " + str.tostring(clr) + "t, need " + str.tostring(minTakeT) + "t" : ""
    string s2 = nearAge < minTakeAge ? "the taken swing was " + str.tostring(nearAge) + " bars old, need " + str.tostring(minTakeAge) : ""
    string s3 = s1 + (s1 != "" and s2 != "" ? " and " : "") + s2
    array.set(nearBox, 0, (nearBear ? "BEARISH" : "BULLISH") + " swing " + str.tostring(nearPx, format.mintick) +
               " bettered " + str.tostring(nearRef, format.mintick) + " but " + s3 +
               "  ·  no take was created, so nothing could mark")

// ══════════════════════════════════════════════════════════════════════════════
// ─── HELPERS ──────────────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════════════
f_kindName(int k) => k == 0 ? "projection band" : k == 1 ? "event horizon" : "sub-band d" + str.tostring(k)

f_kindOK(int k) =>
    sigKinds == "Both" ? true :
     sigKinds == "Event horizons" ? k == 1 :
      (k == 0 or (ehLive and k == 1))

f_dist(float lo, float hi, float p) =>
    p < lo ? lo - p : p > hi ? p - hi : 0.0

f_ext(string d)  => d == "Long (0 at the high)" ? 1.0 : -1.0
f_orig(float hiP, float loP, string d) => d == "Long (0 at the high)" ? hiP : loP
f_opp(float hiP, float loP, string d)  => d == "Long (0 at the high)" ? loP : hiP
f_valid(bool on, float hiP, float loP) => on and hiP > 0 and loP > 0 and hiP != loP

f_ehW() => 1.0 + fibA - fibC

f_mark(int t, float px, string txt, bool bear, color col, string sz, string tip) =>
    array.push(SIG, label.new(t, px, txt, xloc = xloc.bar_time,
               style = bear ? label.style_label_down : label.style_label_up,
               color = col, textcolor = color.white, size = sz, tooltip = tip))
    while array.size(SIG) > sigKeep
        label.delete(array.shift(SIG))
    0

f_subdiv(int units, int depth) =>
    float[] rLo = array.new_float()
    float[] rHi = array.new_float()
    int[]   rD  = array.new_int()
    float[] iLo = array.new_float()
    float[] iHi = array.new_float()
    for u = -units - 1 to units
        array.push(iLo, u)
        array.push(iHi, u + 1.0)
    for d = 0 to depth
        float[] bLo = array.new_float()
        float[] bHi = array.new_float()
        if array.size(iLo) > 0
            for k = 0 to array.size(iLo) - 1
                float a = array.get(iLo, k)
                float b = array.get(iHi, k)
                float w = b - a
                float lo = a + fibA * w
                float hi = a + fibC * w
                array.push(bLo, lo), array.push(bHi, hi)
                array.push(rLo, lo), array.push(rHi, hi), array.push(rD, d)
        array.clear(iLo)
        array.clear(iHi)
        if array.size(bLo) > 1
            for k = 0 to array.size(bLo) - 2
                array.push(iLo, array.get(bHi, k))
                array.push(iHi, array.get(bLo, k + 1))
    [rLo, rHi, rD]

f_pushZone(float a, float b, int kind, float u, float orig, float R, float ex) =>
    float lo = math.min(a, b)
    float hi = math.max(a, b)
    float c  = (lo + hi) / 2.0
    int found = -1
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            Zone z = array.get(zones, i)
            if z.kind == kind and math.abs(z.px - c) <= tolPx
                found := i
                break
    int added = 0
    if found >= 0
        Zone z = array.get(zones, found)
        z.px     := (z.px * z.weight + c) / (z.weight + 1)
        z.lo     := math.min(z.lo, lo)
        z.hi     := math.max(z.hi, hi)
        z.weight += 1
    else if array.size(zones) < maxZones
        array.push(zones, Zone.new(lo = lo, hi = hi, px = c, kind = kind, u = u, ext = ex, orig = orig, R = R))
        added := 1
    added

f_build(bool on, float hiP, float loP, string dir, bool ehOn) =>
    int n = 0
    if f_valid(on, hiP, loP)
        float ex   = f_ext(dir)
        float orig = f_orig(hiP, loP, dir)
        float opp  = f_opp(hiP, loP, dir)
        float R    = math.abs(opp - orig)
        [rLo, rHi, rD] = f_subdiv(projUnits, projDepth)
        if array.size(rLo) > 0
            for k = 0 to array.size(rLo) - 1
                float lo = array.get(rLo, k)
                float hi = array.get(rHi, k)
                int   d  = array.get(rD, k)
                bool skip = not projIn and d == 0 and lo > -1.0 and hi < 0.0
                if not skip
                    n += f_pushZone(orig + ex * lo * R, orig + ex * hi * R, d, (lo + hi) / 2.0, orig, R, ex)
        // at depth ≥ 1 the subdivision already produced the horizons
        if ehOn and projDepth < 1
            float w = f_ehW()
            for u = -projUnits to projUnits
                float eLo = (u - 1.0) + fibC + fibA * w
                float eHi = (u - 1.0) + fibC + fibC * w
                n += f_pushZone(orig + ex * eLo * R, orig + ex * eHi * R, 1, (eLo + eHi) / 2.0, orig, R, ex)
    n

// ══════════════════════════════════════════════════════════════════════════════
// ─── THE REGISTER IS BUILT ONCE ───────────────────────────────────────────────
// Typed: on the first bar, from what you wrote. Signal candle: further down,
// on the bar where the signal candle and its anchor are both known — so no
// band exists, and nothing can signal, before the signal itself.
// ══════════════════════════════════════════════════════════════════════════════
// the projection actually in force, whichever way it was made
var bool   prOn  = false
var float  prHi  = na
var float  prLo  = na
var string prDir = "Short (0 at the low)"
var int    prSigT = na     // signal candle open (signal-candle mode)
var int    prAncT = na     // anchor swing time (signal-candle mode)
if trackOn and barstate.isfirst and not autoMode
    prOn  := pOn
    prHi  := pHi
    prLo  := pLo
    prDir := pDir
    f_build(prOn, prHi, prLo, prDir, pEH)

// ══════════════════════════════════════════════════════════════════════════════
// ─── THE SIGNAL: LIQUIDITY TAKEN INSIDE ONE OF YOUR BANDS ─────────────────────
// ══════════════════════════════════════════════════════════════════════════════
bool sigThisBar = false

f_signal(float takePx, float bodyPx, int takeTime, float tookPx, bool bear, string tfTag, bool doAlert) =>
    float wRef = takePx
    float bRef = bodyPx
    bool  useW = grabBy != "Body (a wick may poke through)"
    bool  useB = grabBy != "Wick (the extreme)"
    float FAR  = 1e12
    int best = -1
    float bd = na
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            Zone z = array.get(zones, i)
            if f_kindOK(z.kind)
                float dW = useW ? f_dist(z.lo, z.hi, wRef) : FAR
                float ov = bear ? math.max(wRef - z.hi, 0.0) : math.max(z.lo - wRef, 0.0)
                float dB = useB and ov <= sweepPx ? f_dist(z.lo, z.hi, bRef) : FAR
                float d  = math.min(dW, dB)
                float d2 = bothIn ? f_dist(z.lo, z.hi, tookPx) : 0.0
                if d <= hitPx and d2 <= hitPx and (best < 0 or d < bd)
                    best := i
                    bd := d
    if best >= 0
        Zone z = array.get(zones, best)
        z.sigs += 1
        z.hits += 1
        bool byWick = useW and f_dist(z.lo, z.hi, wRef) <= hitPx
        float overW = bear ? math.max(wRef - z.hi, 0.0) : math.max(z.lo - wRef, 0.0)
        string tfPre = tfTag == "" ? "" : tfTag + " "
        string txt = tfPre + (bear ? "BEARISH" : "BULLISH") + " " + sigTag +
                      "  ·  " + str.tostring(-z.u, "#.###") + " " + f_kindName(z.kind) +
                      " [" + str.tostring(z.lo, format.mintick) + "–" + str.tostring(z.hi, format.mintick) + "]" +
                      "  ·  " + str.tostring(takePx, format.mintick) + " took " + str.tostring(tookPx, format.mintick) +
                      "  ·  inside by " + (byWick ? "wick" : "body " + str.tostring(bRef, format.mintick) + ", wick swept " + str.tostring(math.round(overW / syminfo.mintick)) + "t past")
        array.set(sigBox, 0, txt)
        array.set(cntBox, 0, array.get(cntBox, 0) + 1)
        color mCol = tfTag == "" ? color.new(bear ? sigColDn : sigColUp, 15) : color.new(htfCol, 15)
        string mSz = tfTag == "" ? sigSize : htfSize
        f_mark(takeTime, takePx, tfPre + sigTag, bear, mCol, mSz, txt)
        if sigShowBox
            int pad = sigBoxPad * math.max(time - time[1], 1)
            array.push(SIGB, box.new(takeTime - pad, z.hi, takeTime + pad, z.lo,
                       xloc = xloc.bar_time, bgcolor = sigBoxCol,
                       border_color = color.new(sigBoxCol, 30), border_width = 1))
            while array.size(SIGB) > sigKeep
                box.delete(array.shift(SIGB))
        if alertOn and doAlert
            alert(txt, alert.freq_once_per_bar)
    else
        float nd = na
        int   ni = -1
        if array.size(zones) > 0
            for i = 0 to array.size(zones) - 1
                Zone z = array.get(zones, i)
                float dw = useW ? f_dist(z.lo, z.hi, wRef) : FAR
                float ovn = bear ? math.max(wRef - z.hi, 0.0) : math.max(z.lo - wRef, 0.0)
                float db = useB and ovn <= sweepPx ? f_dist(z.lo, z.hi, bRef) : FAR
                float d  = math.min(dw, db)
                if na(nd) or d < nd
                    nd := d
                    ni := i
        string why = ""
        if ni < 0
            why := "no projection written — nothing can signal"
        else
            Zone z = array.get(zones, ni)
            bool kindOK = f_kindOK(z.kind)
            float dTook = f_dist(z.lo, z.hi, tookPx)
            string ehNote = z.kind == 1 and not ehArm ? " — Show EH Also Arms It is off" : ""
            float dWn = f_dist(z.lo, z.hi, wRef)
            float dBn = f_dist(z.lo, z.hi, bRef)
            float ovN = bear ? math.max(wRef - z.hi, 0.0) : math.max(z.lo - wRef, 0.0)
            if bothIn and nd <= hitPx and dTook > hitPx
                why := "the taking swing was inside but the taken swing " + str.tostring(tookPx, format.mintick) + " sits " + str.tostring(math.round(dTook / syminfo.mintick)) + "t outside it"
            else if useB and dBn <= hitPx and ovN > sweepPx
                why := "the body " + str.tostring(bRef, format.mintick) + " closed inside but the wick swept " + str.tostring(math.round(ovN / syminfo.mintick)) + "t past the level, more than the " + str.tostring(sweepOut) + "t allowed"
            else if not useB and dWn > hitPx and dBn <= hitPx
                why := "the wick swept " + str.tostring(math.round(dWn / syminfo.mintick)) + "t past the level but the body " + str.tostring(bRef, format.mintick) + " closed inside — set Measure The Take By to Either"
            else if not useW and dBn > hitPx and dWn <= hitPx
                why := "the wick " + str.tostring(wRef, format.mintick) + " was inside but the body sits " + str.tostring(math.round(dBn / syminfo.mintick)) + "t outside — set Measure The Take By to Either"
            else if nd > hitPx
                why := "nearest level " + str.tostring(math.round(nd / syminfo.mintick)) + "t away, need ≤ " + str.tostring(hitTol) + "t"
            else if not kindOK
                why := "landed in a " + f_kindName(z.kind) + ", filtered out by Only Inside" + ehNote
            else
                why := "rejected"
            why := why + "   [" + str.tostring(z.lo, format.mintick) + "–" + str.tostring(z.hi, format.mintick) +
                     " " + f_kindName(z.kind) + "]"
        string mt = (bear ? "BEARISH" : "BULLISH") + " take " + str.tostring(takePx, format.mintick) +
                     " took " + str.tostring(tookPx, format.mintick) +
                     " (wick " + str.tostring(wRef, format.mintick) + ", body " + str.tostring(bRef, format.mintick) +
                     ")  ·  no mark: " + why
        array.set(missBox, 0, mt)
        if showMiss and ni >= 0
            f_mark(takeTime, takePx, "×", bear, color.new(color.gray, 55), size.tiny, (tfTag == "" ? "" : tfTag + " ") + mt)
    best >= 0

// ─── the same swing-and-take test, run on another timeframe ─────────────────
f_htfSwings(string mode, float minTk, int minAge, bool confirmed) =>
    int o = (mode == "3" ? 1 : 2) + (confirmed ? 1 : 0)
    bool sHi = mode == "3" ? high[o] > high[o - 1] and high[o] > high[o + 1] : high[o] > high[o - 2] and high[o] > high[o - 1] and high[o] > high[o + 1] and high[o] > high[o + 2]
    bool sLo = mode == "3" ? low[o]  < low[o - 1]  and low[o]  < low[o + 1]  : low[o]  < low[o - 2]  and low[o]  < low[o - 1]  and low[o]  < low[o + 1]  and low[o]  < low[o + 2]
    var float pHi_ = na
    var int   pHiB = na
    var float pLo_ = na
    var int   pLoB = na
    float takeH = na, float tookH = na, int tH = na, float bH = na
    float takeL = na, float tookL = na, int tL = na, float bL = na
    if sHi
        float p = high[o]
        if not na(pHi_) and p - pHi_ >= minTk and (bar_index - o) - pHiB >= minAge
            takeH := p
            tookH := pHi_
            tH    := time[o]
            bH    := math.max(open[o], close[o])
        pHi_ := p
        pHiB := bar_index - o
    if sLo
        float p = low[o]
        if not na(pLo_) and pLo_ - p >= minTk and (bar_index - o) - pLoB >= minAge
            takeL := p
            tookL := pLo_
            tL    := time[o]
            bL    := math.min(open[o], close[o])
        pLo_ := p
        pLoB := bar_index - o
    [takeH, tookH, tH, bH, takeL, tookL, tL, bL]

float htfMinPx = htfMinTake * syminfo.mintick

[a60H, k60H, t60H, b60H, a60L, k60L, t60L, b60L] = request.security(syminfo.tickerid, "60", f_htfSwings(htfMode, htfMinPx, htfMinAge, htfConfirm), lookahead = barmerge.lookahead_off)
[a30H, k30H, t30H, b30H, a30L, k30L, t30L, b30L] = request.security(syminfo.tickerid, "30", f_htfSwings(htfMode, htfMinPx, htfMinAge, htfConfirm), lookahead = barmerge.lookahead_off)
[a15H, k15H, t15H, b15H, a15L, k15L, t15L, b15L] = request.security(syminfo.tickerid, "15", f_htfSwings(htfMode, htfMinPx, htfMinAge, htfConfirm), lookahead = barmerge.lookahead_off)
[a03H, k03H, t03H, b03H, a03L, k03L, t03L, b03L] = request.security(syminfo.tickerid, "3",  f_htfSwings(htfMode, htfMinPx, htfMinAge, htfConfirm), lookahead = barmerge.lookahead_off)

f_htfNew(int t) => not na(t) and (na(t[1]) or t != t[1])

if trackOn and barstate.isconfirmed and array.size(zones) > 0
    if htfChart
        if sigBear and not na(swHiPxN)
            sigThisBar := f_signal(swHiPxN, swHiBodyN, swHiTimeN, swHiTookN, true, "", true) or sigThisBar
        if sigBull and not na(swLoPxN)
            sigThisBar := f_signal(swLoPxN, swLoBodyN, swLoTimeN, swLoTookN, false, "", true) or sigThisBar
    if htfOn
        bool loud = not htfNotes
        if h60On
            if sigBear and f_htfNew(t60H)
                sigThisBar := f_signal(a60H, b60H, t60H, k60H, true,  "1H", loud) or sigThisBar
            if sigBull and f_htfNew(t60L)
                sigThisBar := f_signal(a60L, b60L, t60L, k60L, false, "1H", loud) or sigThisBar
        if h30On
            if sigBear and f_htfNew(t30H)
                sigThisBar := f_signal(a30H, b30H, t30H, k30H, true,  "30M", loud) or sigThisBar
            if sigBull and f_htfNew(t30L)
                sigThisBar := f_signal(a30L, b30L, t30L, k30L, false, "30M", loud) or sigThisBar
        if h15On
            if sigBear and f_htfNew(t15H)
                sigThisBar := f_signal(a15H, b15H, t15H, k15H, true,  "15M", loud) or sigThisBar
            if sigBull and f_htfNew(t15L)
                sigThisBar := f_signal(a15L, b15L, t15L, k15L, false, "15M", loud) or sigThisBar
        if h03On
            if sigBear and f_htfNew(t03H)
                sigThisBar := f_signal(a03H, b03H, t03H, k03H, true,  "3M", loud) or sigThisBar
            if sigBull and f_htfNew(t03L)
                sigThisBar := f_signal(a03L, b03L, t03L, k03L, false, "3M", loud) or sigThisBar

if trackOn and barstate.isconfirmed and array.size(zones) > 0
    for i = 0 to array.size(zones) - 1
        Zone z = array.get(zones, i)
        if f_dist(z.lo, z.hi, close) == 0.0
            z.hits += 1

alertcondition(sigThisBar, "Swing Sweep — JUDAS", "Liquidity taken inside a projection level")

// ══════════════════════════════════════════════════════════════════════════════
// ─── THE 1m SETUP ─────────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════════════

// Trigger-timeframe swings. Every offset is ≥ 1, so only closed bars are read,
// and with lookahead_on the value is known from the first 1m bar of the next
// trigger bar. Same answer on history and live.
f_trigSwings(int o) =>
    var float sh  = na
    var int   sht = na
    var float sl  = na
    var int   slt = na
    int p = o + 1
    bool isH = o == 1 ? high[p] > high[p + 1] and high[p] > high[p - 1] :
                 high[p] > high[p + 1] and high[p] > high[p + 2] and high[p] > high[p - 1] and high[p] > high[p - 2]
    bool isL = o == 1 ? low[p] < low[p + 1] and low[p] < low[p - 1] :
                 low[p] < low[p + 1] and low[p] < low[p + 2] and low[p] < low[p - 1] and low[p] < low[p - 2]
    if isH
        sh  := high[p]
        sht := time[p]
    if isL
        sl  := low[p]
        slt := time[p]
    [sh, sht, sl, slt]

[trgH, trgHt, trgL, trgLt] = request.security(syminfo.tickerid, setTF, f_trigSwings(off), lookahead = barmerge.lookahead_on)

f_inBand(float px) =>
    bool ok = false
    if not na(px) and array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            Zone z = array.get(zones, i)
            if f_kindOK(z.kind) and f_dist(z.lo, z.hi, px) <= hitPx
                ok := true
                break
    ok

// the chart's own takes: a low that took a low (bearish anchor) and a high
// that took a high (bullish anchor), with their pivot times
// These use the setup's own anchor settings, not the JUDAS Swings group.
var float[] ltlPx = array.new_float()
var int[]   ltlT  = array.new_int()
var float[] htlPx = array.new_float()
var int[]   htlT  = array.new_int()
int   offA   = ancSw == "3" ? 1 : 2
bool  aSwHi  = ancSw == "3" ? isRegular("Buy", 1)  : isBW("Buy", 2)
bool  aSwLo  = ancSw == "3" ? isRegular("Sell", 1) : isBW("Sell", 2)
float aClrPx = ancClr1 * syminfo.mintick
var float aPrevHi = na
var float aPrevLo = na
if aSwLo
    float p = low[offA]
    if not na(aPrevLo) and aPrevLo - p >= aClrPx
        array.push(ltlPx, p), array.push(ltlT, time[offA])
        if array.size(ltlPx) > 300
            array.shift(ltlPx), array.shift(ltlT)
    aPrevLo := p
if aSwHi
    float p = high[offA]
    if not na(aPrevHi) and p - aPrevHi >= aClrPx
        array.push(htlPx, p), array.push(htlT, time[offA])
        if array.size(htlPx) > 300
            array.shift(htlPx), array.shift(htlT)
    aPrevHi := p

// the most recent take before `before` that sits on the far side of 0 and
// makes a fib at least ancMinFib tall — smaller ones are skipped
f_anchor1m(float[] px, int[] ts, int before, float z, int dir) =>
    float ap = na
    int   at = na
    int n = array.size(px)
    if n > 0
        for j = n - 1 to 0
            float q = array.get(px, j)
            if array.get(ts, j) < before and dir * (z - q) > 0 and math.abs(z - q) >= ancMinFib
                ap := q
                at := array.get(ts, j)
                break
    [ap, at]

// the most recent take whose pivot is older than `before`
f_anchor(float[] px, int[] ts, int before) =>
    float ap = na
    int   at = na
    int n = array.size(px)
    if n > 0
        for j = n - 1 to 0
            if array.get(ts, j) < before
                ap := array.get(px, j)
                at := array.get(ts, j)
                break
    [ap, at]

// ══════════════════════════════════════════════════════════════════════════════
// ─── THE PROJECTION FROM THE SIGNAL CANDLE ────────────────────────────────────
// 1 = the signal candle's high (low), 0 = the last Trigger-Timeframe swing low
// that took out another swing low before it (mirror for a low signal).
// ══════════════════════════════════════════════════════════════════════════════
var float[] l15Px = array.new_float()     // trigger-TF lows that took a low
var int[]   l15T  = array.new_int()
var float[] h15Px = array.new_float()     // trigger-TF highs that took a high
var int[]   h15T  = array.new_int()
var float prevL15 = na
var float prevH15 = na
var int   seenL15 = na
var int   seenH15 = na
float ancPx = ancMinT * syminfo.mintick
if not na(trgLt) and (na(seenL15) or trgLt != seenL15)
    seenL15 := trgLt
    if not na(prevL15) and prevL15 - trgL >= ancPx
        array.push(l15Px, trgL), array.push(l15T, trgLt)
        if array.size(l15Px) > 300
            array.shift(l15Px), array.shift(l15T)
    prevL15 := trgL
if not na(trgHt) and (na(seenH15) or trgHt != seenH15)
    seenH15 := trgHt
    if not na(prevH15) and trgH - prevH15 >= ancPx
        array.push(h15Px, trgH), array.push(h15T, trgHt)
        if array.size(h15Px) > 300
            array.shift(h15Px), array.shift(h15T)
    prevH15 := trgH

// the signal candle's extreme, collected from the chart's own bars
int tfMs = timeframe.in_seconds(setTF) * 1000
int t15  = time(setTF)
var int    curT15  = na
var float  curMax  = na
var float  curMin  = na
var int    sigOpen = na
var float  sigHiX  = na
var float  sigLoX  = na
var bool   autoTried = false
var string autoMsg = ""
if autoMode and not na(t15)
    if na(curT15) or t15 != curT15
        if not na(sigOpen) and curT15 == sigOpen and na(sigHiX)
            sigHiX := curMax
            sigLoX := curMin
        curT15 := t15
        curMax := high
        curMin := low
    else
        curMax := math.max(curMax, high)
        curMin := math.min(curMin, low)
    if na(sigOpen) and t15 <= sigT and sigT < t15 + tfMs
        sigOpen := t15

// build as soon as the signal candle has closed and the swing just before it
// is confirmed: 1 bar after it with 3-bar swings, 2 with 5-bar
if autoMode and trackOn and not autoTried and not na(sigHiX) and time >= sigOpen + off * tfMs
    autoTried := true
    bool sBear = sigSide2 == "At a high (short projection)"
    float ap = na
    int   at = na
    if sBear
        [a1, t1] = f_anchor(l15Px, l15T, sigOpen)
        ap := a1
        at := t1
    else
        [a2, t2] = f_anchor(h15Px, h15T, sigOpen)
        ap := a2
        at := t2
    float sx = sBear ? sigHiX : sigLoX
    if na(ap)
        autoMsg := "no " + setTF + (sBear ? " swing low that took a low" : " swing high that took a high") + " before the signal candle — scroll back / load more history"
    else if (sBear and ap >= sx) or (not sBear and ap <= sx)
        autoMsg := "anchor " + str.tostring(ap, format.mintick) + " is on the wrong side of the signal " + str.tostring(sx, format.mintick) + " — check Signal Is"
    else
        prOn   := true
        prHi   := sBear ? sx : ap
        prLo   := sBear ? ap : sx
        prDir  := sBear ? "Short (0 at the low)" : "Long (0 at the high)"
        prSigT := sigOpen
        prAncT := at
        array.clear(zones)
        f_build(prOn, prHi, prLo, prDir, pEH)

var float[] setLv = array.from(0.0, rngFib, 0.5, entFib, 1.0)

f_lvl(float z, float a, float lv) => math.round_to_mintick(z - (z - a) * lv)

f_fibSet(line[] ls, label[] lb, float z, float a, int x1, int x2) =>
    if array.size(ls) == 5 and not na(a)
        for k = 0 to 4
            float lv = array.get(setLv, k)
            float p  = f_lvl(z, a, lv)
            line.set_xy1(array.get(ls, k), x1, p)
            line.set_xy2(array.get(ls, k), x2, p)
            label.set_xy(array.get(lb, k), x2, p)
            label.set_text(array.get(lb, k), str.tostring(lv, "#.###") + " (" + str.tostring(p, format.mintick) + ")")
    0

// state: 0 waiting · 1 measuring · 2 armed (limit working) · 3 in the trade
var int   st    = 0
var int   sd    = 0          // 1 short · −1 long
var float zPx   = na
var int   zT    = na
var float aPx   = na
var int   aT    = na
var float eLvl  = na
var float eSL   = na
var float eTP   = na
var bool  hiUsed = true
var bool  loUsed = true
var int   lastHt = na
var int   lastLt = na
var int   nTr  = 0
var int   nWin = 0
var int   nLos = 0
var float netR = 0.0
var string lastRes = ""
var int   tries  = 0         // trades taken on the current 15m take
var int   restT  = na        // bar a re-measure started on (no arming on it)

var line[]  curL   = array.new_line()
var label[] curLb  = array.new_label()
var box[]   curB   = array.new_box()
var line[]  allL   = array.new_line()
var label[] allLb  = array.new_label()
var box[]   allB   = array.new_box()

// a fresh fib drawing for a new measurement
f_newFib(float z) =>
    array.clear(curL)
    array.clear(curLb)
    for k = 0 to 4
        line l = line.new(time, z, time, z, xloc = xloc.bar_time, color = setFibCol,
                   style = k == 3 ? line.style_solid : line.style_dashed, width = k == 3 ? 2 : 1)
        label t = label.new(time, z, "", xloc = xloc.bar_time, style = label.style_label_left,
                   color = color.new(color.white, 100), textcolor = setFibCol, size = size.tiny)
        array.push(curL, l), array.push(allL, l)
        array.push(curLb, t), array.push(allLb, t)
    0

// a new trigger swing is fresh until price trades past it
if not na(trgHt) and (na(lastHt) or trgHt != lastHt)
    lastHt := trgHt
    hiUsed := false
if not na(trgLt) and (na(lastLt) or trgLt != lastLt)
    lastLt := trgLt
    loUsed := false

int barMs = timeframe.in_seconds() * 1000
int xEnd  = time + 15 * barMs
f_sn() => sd == 1 ? "SHORT" : "LONG"

bool setupArmed   = false
bool setupStarted = false

// ── confirmation: a close past the projection leg's 0.618 ───────────────────
f_confLvl() =>
    float lv = na
    if f_valid(prOn, prHi, prLo)
        bool pBear = prDir == "Short (0 at the low)"
        lv := pBear ? math.round_to_mintick(prHi - confFib * (prHi - prLo)) : math.round_to_mintick(prLo + confFib * (prHi - prLo))
    lv
float confLvl = f_confLvl()
bool  projBear = prDir == "Short (0 at the low)"
var bool confDone = false
var int  confT    = na
int   tC  = time(setTF)
bool  newTF = not na(tC) and not na(tC[1]) and tC != tC[1]
if confOn and not confDone and not na(confLvl) and barstate.isconfirmed
    bool useTF = confTF == "Trigger timeframe close"
    // the trigger-TF close is known on the first chart bar of the next trigger bar
    float cpx = useTF ? (newTF ? close[1] : na) : close
    int   ct  = useTF ? (newTF ? time[1] : na) : time
    bool  late = autoMode ? (not na(prSigT) and not na(ct) and ct >= prSigT + timeframe.in_seconds(setTF) * 1000) : true
    if not na(cpx) and late and (projBear ? cpx < confLvl : cpx > confLvl)
        confDone := true
        confT    := time
        label.new(ct, cpx, "confirmed", xloc = xloc.bar_time,
                   style = projBear ? label.style_label_up : label.style_label_down,
                   color = color.new(pCol, 20), textcolor = color.white, size = size.tiny,
                   tooltip = "Closed " + (projBear ? "below " : "above ") + str.tostring(confFib) + " of the projection (" + str.tostring(confLvl, format.mintick) + ") — setups may start from here")
// true when this direction may start a setup now
f_confOK(bool wantShort) => not confOn or (wantShort != projBear) or (confDone and time > confT)
bool inBlock = blkOn and not na(time(timeframe.period, blkSess, blkTZ))
bgcolor(blkShade and inBlock ? blkCol : na, title="Blocked Hours")

if setOn and trackOn and barstate.isconfirmed and array.size(zones) > 0
    float ext = sd == 1 ? high : low      // toward the stop
    float opp = sd == 1 ? low  : high     // toward the target

    // ── in the trade: stop first, so a bar that touches both counts as a loss
    if st == 3
        bool hitSL = sd * (ext - eSL) >= 0
        bool hitTP = not hitSL and sd * (opp - eTP) <= 0
        if hitSL or hitTP
            nTr  += 1
            nWin += hitTP ? 1 : 0
            nLos += hitSL ? 1 : 0
            netR += hitTP ? rrTP : -1.0
            lastRes := f_sn() + (hitTP ? " TP +" + str.tostring(rrTP) + "R" : " SL −1R") + " at " + str.tostring(hitTP ? eTP : eSL, format.mintick)
            array.push(allLb, label.new(time, hitTP ? eTP : eSL, hitTP ? "TP" : "SL", xloc = xloc.bar_time,
                       style = (hitTP == (sd == 1)) ? label.style_label_up : label.style_label_down,
                       color = hitTP ? setRewCol : setRiskCol, textcolor = color.white, size = size.tiny))
            for b in curB
                box.set_right(b, time)
            if alFull
                alert(lastRes, alert.freq_once_per_bar)
            st := 0
            // stopped by price running on: measure again from the new extreme
            if hitSL and tries < maxTries and not inBlock
                st    := 1
                tries += 1
                zPx   := ext
                zT    := time
                aPx   := na
                aT    := na
                restT := time
                f_newFib(zPx)
        else
            for b in curB
                box.set_right(b, xEnd)
            f_fibSet(curL, curLb, zPx, aPx, aT, xEnd)

    // ── blocked hours: drop a setup that has not filled yet
    if inBlock and blkCancel and (st == 1 or st == 2)
        bool wasArmed = st == 2
        lastRes := f_sn() + (wasArmed ? " cancelled while armed (limit " + str.tostring(eLvl, format.mintick) + ")" : " cancelled while measuring") + " — blocked hours"
        array.push(allLb, label.new(time, wasArmed ? eLvl : zPx, "blocked", xloc = xloc.bar_time,
                   style = sd == 1 ? label.style_label_down : label.style_label_up,
                   color = color.new(color.gray, 30), textcolor = color.white, size = size.tiny))
        if alArm and wasArmed
            alert(f_sn() + " CANCEL limit " + str.tostring(eLvl, format.mintick) + " — blocked hours started", alert.freq_once_per_bar)
        st := 0

    // ── armed: the limit fills when price trades back to the entry level
    if st == 2
        f_fibSet(curL, curLb, zPx, aPx, aT, xEnd)
        if sd * (ext - eLvl) >= 0
            st := 3
            array.clear(curB)
            box bR = box.new(time, math.max(eLvl, eSL), xEnd, math.min(eLvl, eSL), xloc = xloc.bar_time,
                       bgcolor = color.new(setRiskCol, 80), border_color = color.new(setRiskCol, 40))
            box bW = box.new(time, math.max(eLvl, eTP), xEnd, math.min(eLvl, eTP), xloc = xloc.bar_time,
                       bgcolor = color.new(setRewCol, 80), border_color = color.new(setRewCol, 40))
            array.push(curB, bR), array.push(curB, bW)
            array.push(allB, bR), array.push(allB, bW)
            if alFull
                alert(f_sn() + " filled at " + str.tostring(eLvl, format.mintick) + " · SL " + str.tostring(eSL, format.mintick) + " · TP " + str.tostring(eTP, format.mintick), alert.freq_once_per_bar)
            // the fill bar can run on through the stop
            if sd * (ext - eSL) >= 0
                nTr  += 1
                nLos += 1
                netR -= 1.0
                lastRes := f_sn() + " SL −1R at " + str.tostring(eSL, format.mintick) + " (same bar as the fill)"
                for b in curB
                    box.set_right(b, time)
                if alFull
                    alert(lastRes, alert.freq_once_per_bar)
                st := 0
                if tries < maxTries and not inBlock
                    st    := 1
                    tries += 1
                    zPx   := ext
                    zT    := time
                    aPx   := na
                    aT    := na
                    restT := time
                    f_newFib(zPx)

    // ── waiting: price trades past a fresh trigger swing inside a band
    if st == 0
        bool goShort = not inBlock and f_confOK(true) and sigBear and not hiUsed and high > trgH and f_inBand(trgH)
        bool goLong  = not inBlock and f_confOK(false) and not goShort and sigBull and not loUsed and low < trgL and f_inBand(trgL)
        if goShort or goLong
            st  := 1
            sd  := goShort ? 1 : -1
            zPx := goShort ? high : low
            zT  := time
            aPx := na
            aT  := na
            tries := 1
            restT := na
            f_newFib(zPx)
            array.push(allLb, label.new(time, goShort ? trgH : trgL, setTF + " taken", xloc = xloc.bar_time,
                       style = goShort ? label.style_label_down : label.style_label_up,
                       color = color.new(setFibCol, 30), textcolor = color.white, size = size.tiny))
            setupStarted := true
            if alarmOn
                alert("🔔 " + syminfo.ticker + " " + f_sn() + " SETUP — " + setTF + " swing " + str.tostring(goShort ? trgH : trgL, format.mintick) +
                      " taken inside a band. Measuring the fib now; you get a second alarm with the limit when a 1m candle closes past " + str.tostring(entFib) + ".",
                      alert.freq_once_per_bar)

    // used up whether or not it started a setup
    if not na(trgH) and high > trgH
        hiUsed := true
    if not na(trgL) and low < trgL
        loUsed := true

    // ── measuring: move 0 with every new extreme, re-pick 1, arm on a close past the entry level
    if st == 1
        float e1 = sd == 1 ? high : low
        if sd * (e1 - zPx) > 0
            zPx := e1
            zT  := time
        float ap = na
        int   at = na
        if sd == 1
            [p1, t1] = f_anchor1m(ltlPx, ltlT, zT, zPx, sd)
            ap := p1
            at := t1
        else
            [p2, t2] = f_anchor1m(htlPx, htlT, zT, zPx, sd)
            ap := p2
            at := t2
        aPx := ap
        aT  := at
        if not na(aPx) and sd * (zPx - aPx) > 0
            f_fibSet(curL, curLb, zPx, aPx, aT, xEnd)
            float lE = f_lvl(zPx, aPx, entFib)
            float lR = f_lvl(zPx, aPx, rngFib)
            if sd * (close - lE) < 0 and (na(restT) or time != restT)
                float risk = math.abs(lR - lE) * slMult
                eLvl := lE
                eSL  := math.round_to_mintick(lE + sd * risk)
                eTP  := math.round_to_mintick(lE - sd * rrTP * risk)
                st   := 2
                setupArmed := true
                if alArm
                    alert("🔔 " + syminfo.ticker + " " + f_sn() + " ARMED · limit " + str.tostring(eLvl, format.mintick) + " · SL " + str.tostring(eSL, format.mintick) +
                          " · TP " + str.tostring(eTP, format.mintick) + "  (fib 0 " + str.tostring(zPx, format.mintick) +
                          " · 1 " + str.tostring(aPx, format.mintick) + ")", alert.freq_once_per_bar)

    // chart-object budget
    while array.size(allL) > setKeep * 5
        line.delete(array.shift(allL))
    while array.size(allLb) > setKeep * 7
        label.delete(array.shift(allLb))
    while array.size(allB) > setKeep * 2
        box.delete(array.shift(allB))

// Plain alerts for just these moments, for when you'd rather not use
// "Any alert() function call" (which also carries the JUDAS alerts).
alertcondition(alarmOn and setupStarted, "🔔 Setup APPEARED — trigger swing taken in a band", "{{ticker}}: a setup appeared — the trigger-timeframe swing inside a band was taken. Measuring the fib now.")
alertcondition(alarmOn and setupArmed, "Setup ARMED — close past 0.618", "{{ticker}}: setup ARMED — a 1m candle closed past 0.618. Place the limit at 0.618 (prices in the table).")

// ══════════════════════════════════════════════════════════════════════════════
// ─── DRAWING ──────────────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════════════
var line[] L = array.new_line(), var label[] T = array.new_label(), var box[] B = array.new_box()

f_clear() =>
    while array.size(L) > 0
        line.delete(array.pop(L))
    while array.size(T) > 0
        label.delete(array.pop(T))
    while array.size(B) > 0
        box.delete(array.pop(B))
    0

f_lvlBox(float px, int x0, int x1, color c, string exMode) =>
    float h = projThick * syminfo.mintick / 2.0
    array.push(B, box.new(x0, px + h, x1, px - h, xloc=xloc.bar_index, extend=exMode,
               bgcolor=color.new(c, boxOp), border_color=color.new(c, math.max(boxOp - 25, 0)), border_width=1))
    0

f_fill(float y1, float y2, int x0, int x1, color c, string exMode) =>
    array.push(B, box.new(x0, math.max(y1, y2), x1, math.min(y1, y2), xloc=xloc.bar_index, extend=exMode,
               bgcolor=color.new(c, bandOp), border_color=color.new(c, math.max(bandOp - 30, 0)), border_width=1))
    0

f_ehBox(float y1, float y2, int x0, int x1, color c, string exMode) =>
    array.push(B, box.new(x0, math.max(y1, y2), x1, math.min(y1, y2), xloc=xloc.bar_index, extend=exMode,
               bgcolor=color.new(c, ehOp), border_color=color.new(c, math.max(ehOp - 40, 0)), border_width=1))
    0

f_draw(bool on, float hiP, float loP, string dir, color col, color fillCol, bool ehOn, color ehCol) =>
    if drawOn and f_valid(on, hiP, loP)
        bool perRatio = projColMode == "One colour per ratio"
        color cW = perRatio ? colW : col
        color cA = perRatio ? colA : col
        color cB = perRatio ? colB : col
        color cC = perRatio ? colC : col
        bool doLevelBox = projStyle == "Level boxes"
        bool doBandBox  = projStyle == "Band fill + lines" or projStyle == "Band fill only"
        bool doLines    = projStyle == "Lines" or projStyle == "Band fill + lines"
        string exMode = projExtend == "Both ways" ? extend.both : projExtend == "Right only" ? extend.right : projExtend == "Left only" ? extend.left : extend.none
        float ex   = f_ext(dir)
        float orig = f_orig(hiP, loP, dir)
        float opp  = f_opp(hiP, loP, dir)
        float R    = math.abs(opp - orig)
        int   x0   = math.max(bar_index - projBack, 0)
        int   x1   = bar_index + fibExtend
        [rLo, rHi, rD] = f_subdiv(projUnits, projDepth)
        if array.size(rLo) > 0
            for k = 0 to array.size(rLo) - 1
                float lo = array.get(rLo, k)
                float hi = array.get(rHi, k)
                int   d  = array.get(rD, k)
                bool skip = not projIn and d == 0 and lo > -1.0 and hi < 0.0
                if not skip
                    float pA = orig + ex * lo * R
                    float pC = orig + ex * hi * R
                    float pB = orig + ex * ((lo + hi) / 2.0) * R
                    if doBandBox
                        if fillAll and d == 0
                            float n0 = math.round(lo - fibA)
                            float p0 = orig + ex * n0 * R
                            float p1 = orig + ex * (n0 + 1.0) * R
                            f_fill(p0, pA, x0, x1, perRatio ? fill1 : fillCol, exMode)
                            f_fill(pA, pB, x0, x1, perRatio ? fill2 : fillCol, exMode)
                            f_fill(pB, pC, x0, x1, perRatio ? fill3 : fillCol, exMode)
                            f_fill(pC, p1, x0, x1, perRatio ? fill4 : fillCol, exMode)
                        else
                            f_fill(pA, pC, x0, x1, perRatio ? bandCol : fillCol, exMode)
                    if doLevelBox
                        f_lvlBox(pA, x0, x1, cA, exMode)
                        f_lvlBox(pB, x0, x1, cB, exMode)
                        f_lvlBox(pC, x0, x1, cC, exMode)
                    if doLines
                        array.push(L, line.new(x0, pA, x1, pA, xloc=xloc.bar_index, color=cA, width=1, extend=exMode))
                        array.push(L, line.new(x0, pB, x1, pB, xloc=xloc.bar_index, color=cB, width=1, extend=exMode))
                        array.push(L, line.new(x0, pC, x1, pC, xloc=xloc.bar_index, color=cC, width=1, extend=exMode))
                    if projLbl
                        array.push(T, label.new(x1, pA, str.tostring(-lo, "#.###"), xloc=xloc.bar_index,
                                   style=label.style_label_left, color=color.new(color.white, 100), textcolor=cA, size=fibLblSize))
                        array.push(T, label.new(x1, pC, str.tostring(-hi, "#.###"), xloc=xloc.bar_index,
                                   style=label.style_label_left, color=color.new(color.white, 100), textcolor=cC, size=fibLblSize))
        float ehW = f_ehW()
        for u = -projUnits to projUnits
            float p = orig + ex * u * R
            if ehOn
                float eLo = (u - 1.0) + fibC + fibA * ehW
                float eHi = (u - 1.0) + fibC + fibC * ehW
                f_ehBox(orig + ex * eLo * R, orig + ex * eHi * R, x0, x1, ehCol, exMode)
            if doLevelBox
                f_lvlBox(p, x0, x1, cW, exMode)
            if doLines
                array.push(L, line.new(x0, p, x1, p, xloc=xloc.bar_index, color=cW,
                           width = u == 0 or u == -1 ? 2 : 1, extend=exMode))
            if projLbl
                array.push(T, label.new(x1, p, (u == 0 ? "0" : u == -1 ? "1" : str.tostring(-u)) +
                           "  " + str.tostring(p, format.mintick), xloc=xloc.bar_index,
                           style=label.style_label_left, color=color.new(color.white, 100), textcolor=cW, size=fibLblSize))
    0

if barstate.islast
    f_clear()
    f_draw(prOn, prHi, prLo, prDir, pCol, pFill, pEH, pEHC)
    // the measured leg, anchor → signal, so you can check it picked the right two swings
    if drawOn and autoMode and prOn and not na(prAncT) and not na(prSigT)
        bool lgBear = prDir == "Short (0 at the low)"
        if confOn and not na(confLvl)
            array.push(L, line.new(prSigT, confLvl, prSigT + 1, confLvl, xloc=xloc.bar_time, extend=extend.right,
                       color=color.new(pCol, confDone ? 70 : 0), style=line.style_dotted, width=2))
            array.push(T, label.new(bar_index + fibExtend, confLvl, "confirm " + str.tostring(confFib) + (confDone ? " ✓" : ""), xloc=xloc.bar_index,
                       style=label.style_label_left, color=color.new(color.white, 100), textcolor=pCol, size=fibLblSize))
        array.push(L, line.new(prAncT, lgBear ? prLo : prHi, prSigT, lgBear ? prHi : prLo, xloc=xloc.bar_time,
                   color=pCol, style=line.style_dashed, width=2))

// ══════════════════════════════════════════════════════════════════════════════
// ─── STATE TABLE ──────────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════════════
var table tb = na
if showTable and barstate.islast
    if not na(tb)
        table.delete(tb)
    int nZ = array.size(zones)
    int nEH = 0
    if nZ > 0
        for i = 0 to nZ - 1
            if array.get(zones, i).kind == 1
                nEH += 1
    int[] ord = array.new_int()
    if nZ > 0
        for i = 0 to nZ - 1
            array.push(ord, i)
        int want = math.min(tblRows, nZ)
        if want > 0
            for a = 0 to want - 1
                int bestI = a
                if a < nZ - 1
                    for b = a + 1 to nZ - 1
                        Zone zb = array.get(zones, array.get(ord, b))
                        Zone za = array.get(zones, array.get(ord, bestI))
                        if f_dist(zb.lo, zb.hi, close) < f_dist(za.lo, za.hi, close)
                            bestI := b
                if bestI != a
                    int tmp = array.get(ord, a)
                    array.set(ord, a, array.get(ord, bestI))
                    array.set(ord, bestI, tmp)
    int nShow = math.min(tblRows, nZ)
    tb := table.new(f_pos(tblPos), 2, 10 + nShow, bgcolor=color.new(color.black, 20), border_color=color.new(color.gray, 55), border_width=1)
    int r = 0
    table.cell(tb, 0, r, "Swing Sweep", text_color=color.white, bgcolor=color.new(color.navy, 30), text_size=size.small)
    table.cell(tb, 1, r, "v7.9 · " + (sigBear and sigBull ? "BOTH" : sigBear ? "BEARISH" : "BULLISH"), text_color=color.white, bgcolor=color.new(color.navy, 30), text_size=size.small)
    r += 1
    // the alarm switch and how to receive it
    string alTxt = alarmOn ?
         "ON — create ONE alert: Condition \"Judas Projection\" → \"Any alert() function call\". Re-create it after you move the signal candle or change a setting." :
         "OFF — tick 🔔 Set alarm when setup appears at the top of the settings"
    table.cell(tb, 0, r, "🔔 Alarm", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, r, alTxt, text_color = alarmOn ? color.lime : color.orange, text_size=size.small)
    r += 1
    string ptxt = ""
    bool   pOK  = f_valid(prOn, prHi, prLo)
    if pOK
        float orig = f_orig(prHi, prLo, prDir)
        float opp  = f_opp(prHi, prLo, prDir)
        ptxt := (autoMode ? "signal " + str.format_time(prSigT, "MMM dd HH:mm", blkTZ) + " · " : "") +
                 "0 " + str.tostring(orig, format.mintick) + " 1 " + str.tostring(opp, format.mintick) +
                 " R " + str.tostring(math.abs(opp - orig), format.mintick) + (pEH ? " +EH" : "")
    else if autoMode
        ptxt := autoMsg != "" ? autoMsg :
                 na(sigOpen) ? "the signal candle " + str.format_time(sigT, "MMM dd HH:mm", blkTZ) + " is not in this chart's history — click a candle you can see" :
                 "waiting for the signal candle to close and the swings before it to confirm"
    else if pOn
        ptxt := "INVALID (write a high and a low, both above zero and not equal)"
    table.cell(tb, 0, r, "Projection", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, r, ptxt == "" ? "none written — write a high and a low and nothing can signal until you do" : ptxt,
               text_color = pOK ? color.lime : color.orange, text_size=size.small)
    r += 1
    string ehState = ""
    if nEH > 0
        if ehLive
            ehState := " ARMED"
        else if sigKinds == "Projection bands"
            ehState := " DRAWN ONLY — arming off and Only Inside excludes them"
        else
            ehState := " (via Only Inside)"
    string ehTxt = nEH == 0 ? "" : "  ·  " + str.tostring(nEH) + " event horizon" + (nEH == 1 ? "" : "s") + ehState
    color  lvlCol = nZ == 0 ? color.orange : (nEH > 0 and not ehLive and sigKinds == "Projection bands" ? color.orange : color.silver)
    string lvlTxt = str.tostring(nZ) + " levels  ·  " + str.tostring(projUnits) + " units each way, depth " + str.tostring(projDepth) + ehTxt
    lvlTxt := lvlTxt + (ehAny and projDepth >= 1 ? "  ·  horizons came from the subdivision, Show EH is drawing only here" : "")
    lvlTxt := lvlTxt + (nZ >= maxZones ? "  ·  AT THE CEILING, raise Hold This Many Levels" : "")
    table.cell(tb, 0, r, "Levels", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, r, lvlTxt, text_color=lvlCol, text_size=size.small)
    r += 1
    if nShow > 0
        for k = 0 to nShow - 1
            Zone z = array.get(zones, array.get(ord, k))
            float d = f_dist(z.lo, z.hi, close)
            string txt = str.tostring(z.lo, format.mintick) + " – " + str.tostring(z.hi, format.mintick) +
                          "  " + f_kindName(z.kind) + " " + str.tostring(-z.u, "#.###") +
                          (d > 0 ? "  ·  " + str.tostring(math.round(d / syminfo.mintick)) + "t away" : "  ·  price inside") +
                          (z.sigs > 0 ? "  ·  " + str.tostring(z.sigs) + " " + sigTag : "")
            table.cell(tb, 0, r, "Level", text_color=color.silver, text_size=size.small)
            table.cell(tb, 1, r, txt, text_color = d == 0 ? color.white : color.silver, text_size=size.small)
            r += 1
    string tfList = (htfChart ? "chart " + timeframe.period : "")
    if htfOn
        tfList := tfList + (h60On ? (tfList == "" ? "" : " · ") + "1h" : "")
        tfList := tfList + (h30On ? (tfList == "" ? "" : " · ") + "30m" : "")
        tfList := tfList + (h15On ? (tfList == "" ? "" : " · ") + "15m" : "")
        tfList := tfList + (h03On ? (tfList == "" ? "" : " · ") + "3m" : "")
    string tfNote = htfOn and not htfChart and tfList == "" ? "nothing ticked — no take can be tested" : tfList == "" ? "chart timeframe off and other timeframes off — nothing is watched" : tfList + (htfOn and htfNotes ? "   ·   other timeframes are notes, no alerts" : "") + (htfOn and not htfConfirm ? "   ·   unconfirmed, notes may repaint" : "")
    table.cell(tb, 0, r, "Watching", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, r, tfNote, text_color = tfList == "" ? color.orange : color.silver, text_size=size.small)
    r += 1
    string lastSig = array.get(sigBox, 0)
    table.cell(tb, 0, r, "Last " + sigTag, text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, r, lastSig == "" ? "—" : lastSig, text_color=lastSig == "" ? color.gray : color.lime, text_size=size.small)
    r += 1
    string lastMiss = array.get(missBox, 0)
    table.cell(tb, 0, r, "Last take", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, r, lastMiss == "" ? "—" : lastMiss, text_color=lastMiss == "" ? color.gray : color.orange, text_size=size.small)
    r += 1
    string lastNear = array.get(nearBox, 0)
    table.cell(tb, 0, r, "Last near-take", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, r, lastNear == "" ? "—" : lastNear, text_color=lastNear == "" ? color.gray : color.yellow, text_size=size.small)
    r += 1
    string sTxt = ""
    color  sCol = color.silver
    if not setOn
        sTxt := "off"
    else if timeframe.in_seconds() >= timeframe.in_seconds(setTF)
        sTxt := "put the script on a chart BELOW " + setTF + " (1-minute) — the trigger has to come from a higher timeframe"
        sCol := color.orange
    else if st == 0 and confOn and not confDone and not na(confLvl)
        sTxt := "waiting for a " + (confTF == "Trigger timeframe close" ? setTF : "1m") + " close " + (projBear ? "BELOW " : "ABOVE ") +
                 str.tostring(confFib) + " of the projection (" + str.tostring(confLvl, format.mintick) + ") — no " + (projBear ? "short" : "long") + " setups until then"
        sCol := color.yellow
    else if st == 0 and inBlock
        sTxt := "BLOCKED HOURS " + blkSess + " " + blkTZ + " — no new setups"
        sCol := color.gray
    else if st == 0
        sTxt := "waiting for price to trade past a fresh " + setTF + " swing inside a band" +
                 (not na(trgH) and not hiUsed and sigBear ? "  ·  high " + str.tostring(trgH, format.mintick) + (f_inBand(trgH) ? " (in band)" : " (outside)") : "") +
                 (not na(trgL) and not loUsed and sigBull ? "  ·  low " + str.tostring(trgL, format.mintick) + (f_inBand(trgL) ? " (in band)" : " (outside)") : "")
    else if st == 1
        sTxt := f_sn() + " MEASURING" + (tries > 1 ? " (attempt " + str.tostring(tries) + "/" + str.tostring(maxTries) + ")" : "") + "  ·  0 " + str.tostring(zPx, format.mintick) +
                 (na(aPx) ? "  ·  no anchor take yet" + (ancMinFib > 0 ? " at least " + str.tostring(ancMinFib) + " away" : "") : "  ·  1 " + str.tostring(aPx, format.mintick) + "  ·  a close past " + str.tostring(f_lvl(zPx, aPx, entFib), format.mintick) + " arms it")
        sCol := color.yellow
    else if st == 2
        sTxt := f_sn() + " ARMED  ·  limit " + str.tostring(eLvl, format.mintick) + "  ·  SL " + str.tostring(eSL, format.mintick) + "  ·  TP " + str.tostring(eTP, format.mintick)
        sCol := color.aqua
    else
        sTxt := "IN " + f_sn() + " from " + str.tostring(eLvl, format.mintick) + "  ·  SL " + str.tostring(eSL, format.mintick) + "  ·  TP " + str.tostring(eTP, format.mintick)
        sCol := color.lime
    table.cell(tb, 0, r, "Setup", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, r, sTxt, text_color=sCol, text_size=size.small)
    r += 1
    string rTxt = nTr == 0 ? "no closed trades yet" : str.tostring(nTr) + " trades  ·  " + str.tostring(nWin) + " won  ·  " + str.tostring(nLos) + " lost  ·  " +
                  str.tostring(100.0 * nWin / nTr, "#.#") + "%  ·  net " + (netR >= 0 ? "+" : "") + str.tostring(netR, "#.##") + "R" +
                  (lastRes == "" ? "" : "  ·  last: " + lastRes)
    table.cell(tb, 0, r, "Results", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, r, rTxt, text_color = netR > 0 ? color.lime : netR < 0 ? color.orange : color.silver, text_size=size.small)
